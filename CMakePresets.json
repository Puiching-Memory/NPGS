{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows · MSVC (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows",
      "description": "项目级依赖：vcpkg 位于 third_party/vcpkg（先运行 scripts/bootstrap-vcpkg.ps1），依赖安装到 NPGS/vcpkg_installed。",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/NPGS/vcpkg_installed"
      }
    },
    {
      "name": "windows-msvc-package",
      "displayName": "Windows · MSVC Package（打包版）",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build/windows-package",
      "cacheVariables": {
        "NPGS_PACKAGE": "ON"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux · GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "description": "项目级依赖：vcpkg 位于 third_party/vcpkg（先运行 scripts/bootstrap-vcpkg.sh），依赖安装到 NPGS/vcpkg_installed。",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/NPGS/vcpkg_installed",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux · GCC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "description": "项目级依赖：vcpkg 位于 third_party/vcpkg（先运行 scripts/bootstrap-vcpkg.sh），依赖安装到 NPGS/vcpkg_installed。",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/NPGS/vcpkg_installed",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-package-release",
      "configurePreset": "windows-msvc-package",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    }
  ]
}
