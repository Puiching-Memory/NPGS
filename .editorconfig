root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,inl,glsl}]
indent_style = space
indent_size = 4

[{CMakeLists.txt,*.cmake,*.json,*.yml,*.yaml,*.py,*.ps1,*.sh}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
